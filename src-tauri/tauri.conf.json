{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dark School",
  "version": "1.0.0",
  "identifier": "com.houssamdev.darkschool",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DARK SCHOOL",
        "width": 1280,
        "height": 720,
        "minWidth": 800,
        "minHeight": 450,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "3D horror game",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
